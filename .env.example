SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# Lightning (Blink custodial API) — https://dashboard.blink.sv
BLINK_API_KEY=
BLINK_API_URL=https://api.blink.sv/graphql
BLINK_WS_URL=wss://ws.blink.sv/graphql
BLINK_WS_USER_AGENT=BtcWalletBlinkWS/1.0

# On-chain BTC via a direct LND node (optional; not required for Lightning-only use)
LND_REST_URL=
LND_MACAROON=
LND_CERT_PATH=./tls.cert

# On-chain BTC custody (python-bitcoinlib). Keep BITCOIN_NETWORK=testnet until
# this has had a security review. Generate WALLET_ENCRYPTION_KEY with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BITCOIN_NETWORK=testnet
WALLET_ENCRYPTION_KEY=

# AmatoPay merchant API (BIF mobile-money top-ups) — sk_... secret key
AMATOPAY_API_KEY=
AMATOPAY_BASE_URL=http://localhost:8000

# Celery (Blink invoice-poll fallback task)
REDIS_URL=redis://localhost:6379/0
