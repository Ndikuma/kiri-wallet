SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO

# Lightning (Blink custodial API) — https://dashboard.blink.sv
BLINK_API_KEY=
BLINK_API_URL=https://api.blink.sv/graphql
BLINK_WS_URL=wss://ws.blink.sv/graphql
BLINK_WS_USER_AGENT=BtcWalletBlinkWS/1.0

# On-chain BTC via a direct LND node (optional; not required for Lightning-only use)
LND_REST_URL=
LND_MACAROON=
LND_CERT_PATH=./tls.cert

# On-chain BTC custody (btclib). One of: mainnet, testnet4, testnet, signet.
# testnet4 is the modern, actually-usable test network — testnet3 ("testnet")
# is largely dead in practice (very few faucets still issue it) and, unlike
# testnet4, has no scanning fallback: blockstream.info has no testnet4 API,
# only mempool.space does, so testnet4 relies on mempool.space being reachable
# from wherever you run `worker`/`scan_bitcoin` — verify with:
#   curl https://mempool.space/testnet4/api/blocks/tip/height
# Keep this off mainnet until this has had a security review. Generate
# WALLET_ENCRYPTION_KEY with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BITCOIN_NETWORK=testnet4
WALLET_ENCRYPTION_KEY=

# AmatoPay merchant API (BIF mobile-money top-ups) — sk_... secret key
AMATOPAY_API_KEY=
AMATOPAY_BASE_URL=http://localhost:8000
# whsec_... signing secret for https://<this-host>/webhooks/amatopay/ (Merchant Dashboard -> Developers)
AMATOPAY_WEBHOOK_SECRET=

# Celery (Blink invoice-poll fallback task)
REDIS_URL=redis://localhost:6379/0
